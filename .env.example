# Copy to .env (same folder you run the commands from) and fill in ONE of these.

# Groq - free key, no card: https://console.groq.com/keys   -> run with --model groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (see: python -m errand_agent.check_llm --model groq --list)

# xAI Grok - https://console.x.ai                           -> run with --model grok
XAI_API_KEY=
# GROK_MODEL=grok-4-1-fast-non-reasoning

# Optional: price per million tokens for cost estimates in traces (USD)
# ERRAND_PRICE_IN=0.20
# ERRAND_PRICE_OUT=0.50
